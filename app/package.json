{
  "name": "aduskills-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Single-page multi-provider LLM chat. React SPA + local Node egress bridge so provider calls leave from the user's own IP. No hosted server.",
  "author": "Adarsh",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "start": "node bridge/server.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "gen:models": "python3 scripts/dump_registry.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
