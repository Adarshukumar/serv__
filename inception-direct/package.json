{
  "name": "inception-direct",
  "version": "1.0.0",
  "private": true,
  "description": "A typographic chat for Inception's Mercury model that talks to chat.inceptionlabs.ai straight from your own browser — no servers, no proxies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:extension",
    "build:extension": "vite build && vite build --config vite.content.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/ui.e2e.mjs",
    "zip": "node scripts/zip.mjs",
    "check": "npm run typecheck && npm test && npm run build:extension"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
