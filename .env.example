# ─── SILK ────────────────────────────────────────────────────────────────
# Copy to .env and edit. Every default below is what the app uses if you
# leave the line out. Nothing here is a secret EXCEPT anything you add later;
# .env is git-ignored for that reason.

# Upstream (the real Inception chat API). No proxy: ever.
INCEPTION_BASE_URL=https://chat.inceptionlabs.ai
MODEL_NAME=mercury
REASONING_EFFORT=high                 # disabled | low | medium | high

# ── client IP ──────────────────────────────────────────────────────────────
# Attach the resolved user IP to outbound requests as X-Forwarded-For /
# X-Real-IP / Forwarded. This is ATTRIBUTION METADATA, not source-address
# spoofing — see "The one honest sentence about IP forwarding" in README.md.
FORWARD_CLIENT_IP=1

# The ONLY socket addresses allowed to tell us who the client was.
# behind nginx/caddy on the same box  → 127.0.0.1,::1
# behind Fly/Render/Heroku            → their proxy ranges (check their docs)
# behind Cloudflare                   → also read CF-Connecting-IP (we do)
# exposed directly to the internet    → leave EMPTY, forwarded headers ignored
TRUSTED_PROXIES=127.0.0.1,::1
TRUST_ALL_PROXIES=0                   # 1 = believe anyone. Do not.

# ── our own limits (this is what actually protects the shared upstream IP) ─
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
MAX_CONCURRENCY=8
SESSION_TTL=3600
MAX_HISTORY_TURNS=20

# ── upstream session token ─────────────────────────────────────────────────
TOKEN_TTL=3600
TOKEN_AUTO_REFRESH=0                  # 1 = background thread. Off by default:
                                      # no quota burn when nobody is using the app.
TOKEN_REFRESH_INTERVAL=900

# ── misc ───────────────────────────────────────────────────────────────────
ENABLE_WEB_SEARCH=0
SYSTEM_PROMPT=You are a helpful, precise assistant.
UPSTREAM_TIMEOUT=180
UPSTREAM_CONNECT_TIMEOUT=20
UPSTREAM_MAX_CONNECTIONS=32
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=info
